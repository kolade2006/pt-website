# =========================================================
# PRAISE TABERNACLE - ENVIRONMENT VARIABLES
# =========================================================
# Copy this file to .env for local testing, then add the same
# variables in your hosting dashboard (for example Vercel).
#
# NEVER commit .env or place any of these values in frontend code.

# ---------------------------------------------------------
# CONTACT FORM - EMAIL (Resend)
# ---------------------------------------------------------
# Required for email notifications.
# Get a key from https://resend.com/api-keys
RESEND_API_KEY=

# The church inbox that should receive website enquiries.
# Replace this placeholder with the real church email address.
CHURCH_EMAIL=church-email-placeholder@example.com

# Older name for the same setting (still supported).
# CONTACT_TO_EMAIL=

# The verified sender. In production this must use a domain verified in Resend.
# For initial testing, onboarding@resend.dev can be used.
CONTACT_FROM_EMAIL=Praise Tabernacle <website@your-verified-domain.com>

# Optional extra Reply-To. When empty, the visitor's email is used.
CONTACT_REPLY_TO=

# ---------------------------------------------------------
# CONTACT FORM - DATABASE (Supabase)
# ---------------------------------------------------------
# Optional but recommended. When both values are present, every valid
# submission is stored in the contact_messages table (see supabase/schema.sql).
SUPABASE_URL=

# Use the service_role key, NOT the anon key. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional table name override.
SUPABASE_CONTACT_TABLE=contact_messages

# ---------------------------------------------------------
# CONTACT FORM - WHATSAPP (optional)
# ---------------------------------------------------------
# WhatsApp Business Cloud API credentials.
# See SETUP.md for the requirements and limitations.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Destination number in international format, digits only, e.g. 2348012345678
WHATSAPP_TO_NUMBER=

# Optional approved template name. The template must accept three body
# parameters: {{1}} name, {{2}} subject, {{3}} email.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---------------------------------------------------------
# LOCAL DEVELOPMENT
# ---------------------------------------------------------
# true  = local testing only: validate and write messages to
#         .dev/contact-messages.jsonl without sending anything.
# false = use the real delivery configuration above.
# Development mode is automatically disabled on Vercel and in production.
CONTACT_DEV_MODE=true

# ---------------------------------------------------------
# YOUTUBE INTEGRATION
# ---------------------------------------------------------
# The handle is resolved to the church channel by the backend.
YOUTUBE_CHANNEL_HANDLE=praisetabernacleogombo

# Optional: the resolved UC... channel ID for this church is
# UCVRMUU9ygtCbnBRjeH8b37w. Setting it avoids a handle lookup on a cold start.
YOUTUBE_CHANNEL_ID=

# Creates the official YouTube Data API v3 integration.
# Enable "YouTube Data API v3" in Google Cloud, create an API key, and paste it
# here or in the Vercel environment variables. Never put this key in HTML or
# frontend JavaScript.
# Without a key the backend automatically uses the public RSS feed instead.
YOUTUBE_API_KEY=
